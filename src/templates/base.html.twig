<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Notas{% endblock %}</title>
    <style>
        :root { --fg:#1f2933; --muted:#6b7280; --line:#e5e7eb; --accent:#4d6b63; --bg:#f8f9fa; }
        * { box-sizing: border-box; }
        body { font-family: system-ui, sans-serif; color: var(--fg); background: var(--bg); margin: 0; }
        main { max-width: 720px; margin: 2rem auto; padding: 0 1rem; }
        h1 { margin-bottom: .25rem; }
        a { color: var(--accent); }
        .backend { font-size: .85rem; color: var(--muted); margin-bottom: 1.5rem; }
        .backend code { background:#eef2f0; padding:.1rem .4rem; border-radius:4px; color:var(--accent); }
        .card { background:#fff; border:1px solid var(--line); border-radius:10px; padding:1rem 1.25rem; margin-bottom:.75rem; }
        .card h3 { margin:0 0 .35rem; }
        .cat { display:inline-block; font-size:.75rem; background:#eef2f0; color:var(--accent); padding:.1rem .5rem; border-radius:999px; }
        .acciones { margin-top:.6rem; display:flex; gap:.75rem; align-items:center; }
        .btn { display:inline-block; background:var(--accent); color:#fff; padding:.5rem .9rem; border-radius:8px; text-decoration:none; border:none; cursor:pointer; font-size:.9rem; }
        .btn.sec { background:#fff; color:var(--accent); border:1px solid var(--accent); }
        .btn.link { background:none; color:var(--muted); padding:0; }
        form.inline { display:inline; }
        label { display:block; font-weight:600; margin:.75rem 0 .25rem; }
        input[type=text], textarea { width:100%; padding:.55rem; border:1px solid var(--line); border-radius:8px; font:inherit; }
        textarea { min-height:120px; }
        .empty { color:var(--muted); }
    </style>
</head>
<body>
    <main>
        {% block body %}{% endblock %}
    </main>
</body>
</html>
